<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <title>LUXEVIS – Lo sguardo che osa</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/x-icon" href="favicon.ico" />
  <style>
    :root { --oro:#d4af37; --nero:#000; --grigio:#111; --bianco:#fff; }
    *{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:Arial, sans-serif;background:var(--nero);color:var(--bianco);}
    header{border-bottom:1px solid var(--oro);position:sticky;top:0;background:var(--nero);z-index:100;}
    .top-bar{display:flex;justify-content:space-between;align-items:center;padding:10px 30px;}
    .logo-area{display:flex;align-items:center;gap:12px;}
    .logo-area img{height:60px;}
    nav ul{display:flex;gap:20px;list-style:none;text-transform:uppercase;font-size:14px;}
    nav li{cursor:pointer;position:relative;}
    nav li::after{content:"";position:absolute;left:0;bottom:-4px;width:0;height:2px;background:var(--oro);transition:.2s;}
    nav li:hover::after{width:100%;}
    .cart-indicator{cursor:pointer;display:flex;align-items:center;gap:6px;}
    .cart-indicator img{height:26px;}
    .cart-indicator span{background:var(--oro);color:var(--nero);padding:2px 8px;border-radius:999px;font-size:12px;}
    main{max-width:1200px;margin:auto;padding:30px 20px;}
    .hero{display:grid;grid-template-columns:1.2fr 1fr;gap:30px;padding:40px 20px;background:radial-gradient(circle,#333,#000);border-radius:10px;margin-bottom:50px;position:relative;}
    .hero-logo-bg{position:absolute;left:10px;bottom:10px;opacity:.08;}
    .hero-logo-bg img{height:140px;}
    .hero-text h2{font-size:36px;color:var(--oro);display:flex;align-items:center;gap:10px;}
    .hero-text h2 img{height:40px;}
    .hero-text p{max-width:480px;margin:10px 0 20px;}
    .btn{border:1px solid var(--oro);padding:10px 18px;color:var(--oro);background:transparent;text-transform:uppercase;cursor:pointer;transition:.2s;}
    .btn.primary{background:var(--oro);color:var(--nero);}
    .btn:hover{transform:translateY(-1px);}
    .hero-image img{max-width:100%;border:1px solid var(--oro);border-radius:10px;}
    .section-title{font-size:24px;color:var(--oro);margin:40px 0 20px;display:flex;align-items:center;gap:10px;text-transform:uppercase;}
    .section-title img{height:26px;}
    .featured-product{display:grid;grid-template-columns:1.1fr 1fr;gap:30px;background:var(--grigio);padding:25px;border-radius:10px;}
    .featured-product img{max-width:100%;border:1px solid var(--oro);border-radius:8px;}
    .product-info h3{font-size:20px;color:var(--oro);display:flex;align-items:center;gap:8px;}
    .product-info h3 img{height:26px;}
    .grid-3{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;}
    .card{background:#111;border:1px solid #222;border-radius:8px;padding:18px;position:relative;}
    .card-logo{position:absolute;right:8px;top:8px;opacity:.18;}
    .card-logo img{height:32px;}
    .card h4{color:var(--oro);display:flex;align-items:center;gap:6px;text-transform:uppercase;}
    .card h4 img{height:18px;}
    .card-thumb img{height:40px;border:1px solid var(--oro);border-radius:4px;}
    .badge{border:1px solid var(--oro);color:var(--oro);padding:3px 8px;border-radius:999px;font-size:11px;}
    .assistenza{display:grid;grid-template-columns:1.2fr 1fr;gap:25px;}
    .assistenza-box{background:#111;border:1px solid #222;border-radius:8px;padding:16px;position:relative;}
    .assistenza-box-logo{position:absolute;right:8px;bottom:8px;opacity:.12;}
    .assistenza-box-logo img{height:40px;}
    .assistenza-box h4{color:var(--oro);display:flex;align-items:center;gap:6px;}
    .assistenza-box input,.assistenza-box textarea{width:100%;background:#000;border:1px solid #333;color:#fff;padding:6px;margin-bottom:8px;}
    footer{text-align:center;padding:20px;border-top:1px solid #111;background:#020202;color:#888;}
    footer img{height:40px;margin-bottom:8px;}
    .cart-panel{position:fixed;right:0;top:0;width:320px;height:100vh;background:#050505;border-left:1px solid var(--oro);transform:translateX(100%);transition:.25s;z-index:200;display:flex;flex-direction:column;}
    .cart-panel.open{transform:translateX(0);}
    .cart-header{padding:16px;border-bottom:1px solid #222;display:flex;justify-content:space-between;}
    .cart-header h3{color:var(--oro);display:flex;align-items:center;gap:6px;}
    .cart-header h3 img{height:20px;}
    .cart-body{padding:16px;overflow-y:auto;}
    .cart-item{display:grid;grid-template-columns:60px 1fr;gap:10px;border-bottom:1px solid #222;padding-bottom:10px;margin-bottom:10px;}
    .cart-item img{width:60px;border:1px solid var(--oro);border-radius:4px;}
    .cart-footer{padding:16px;border-top:1px solid #222;}
  </style>
</head>
<body>

<header>
  <div class="top-bar">
    <div class="logo-area">
      <img src="Logo.jpg" alt="Logo LUXEVIS">
      <div>
        <h1 style="color:var(--oro);letter-spacing:4px;">LUXEVIS</h1>
        <span style="color:var(--oro);font-style:italic;">Lo sguardo che osa</span>
      </div>
    </div>
    <nav>
      <ul>
        <li onclick="scrollToSection('home')">Home</li>
        <li onclick="scrollToSection('ultimi')">Ultimi arrivi</li>
        <li onclick="scrollToSection('categorie')">Categorie</li>
        <li onclick="scrollToSection('assistenza')">Assistenza</li>
      </ul>
    </nav>
    <div class="cart-indicator" onclick="toggleCart()">
      <img src="Logo.jpg" alt="">
      <span id="cart-count">0</span>
    </div>
  </div>
</header>

<aside class="cart-panel" id="cart-panel">
  <div class="cart-header">
    <h3><img src="Logo.jpg"> Carrello</h3>
    <div onclick="toggleCart()" style="cursor:pointer;">✕</div>
  </div>
  <div class="cart-body" id="cart-items">Il tuo carrello è vuoto.</div>
  <div class="cart-footer">
    <div style="display:flex;justify-content:space-between;margin-bottom:10px;">
      <span>Totale</span><span id="cart-total">€ 0,00</span>
    </div>
    <button class="btn primary" style="width:100%;">Procedi al pagamento</button>
  </div>
</aside>

<main>

<section id="home" class="hero">
  <div class="hero-logo-bg"><img src="Logo.jpg"></div>
  <div class="hero-text">
    <h2><img src="Logo.jpg"> LUXEVIS</h2>
    <p>Occhiali di lusso per chi osa guardare oltre.</p>
    <button class="btn primary" onclick="scrollToSection('featured')">Scopri la collezione</button>
  </div>
  <div class="hero-image">
    <img src="Occhiale.jpg" alt="Occhiale CARPE DIEM">
  </div>
</section>

<h2 class="section-title"><img src="Logo.jpg"> Prodotto in evidenza</h2>
<section id="featured" class="featured-product">
  <div><img src="Occhiale.jpg"></div>
  <div class="product-info">
    <h3><img src="Logo.jpg"> Occhiali “CARPE DIEM”</h3>
    <p>Montatura dorata, incisioni e carattere unico.</p>
    <div class="price" style="color:var(--oro);font-size:20px;">€ 980,00</div>
    <button class="btn primary" onclick="addToCart()">Aggiungi al carrello</button>
  </div>
</section>

<h2 class="section-title" id="categorie"><img src="Logo.jpg"> Categorie</h2>
<section class="grid-3">
  <article class="card">
    <div class="card-logo"><img src="Logo.jpg"></div>
    <h4><img src="Logo.jpg"> Occhiali da sole</h4>
    <p>Stile e protezione.</p>
    <span class="badge">Iconici</span>
  </article>
  <article class="card">
    <div class="card-logo"><img src="Logo.jpg"></div>
    <h4><img src="Logo.jpg"> Occhiali da vista</h4>
    <p>Eleganza quotidiana.</p>
    <span class="badge">Everyday</span>
  </article>
  <article class="card">
    <div class="card-logo"><img src="Logo.jpg"></div>
    <h4><img src="Logo.jpg"> Edizioni limitate</h4>
    <p>Esclusività assoluta.</p>
    <span class="badge">Limited</span>
  </article>
</section>

<h2 class="section-title" id="ultimi"><img src="Logo.jpg"> Ultimi arrivi</h2>
<section class="grid-3">
  <article class="card">
    <div class="card-logo"><img src="Logo.jpg"></div>
    <div class="card-thumb"><img src="Occhiale.jpg"></div>
    <h4><img src="Logo.jpg"> CARPE DIEM Black Gold</h4>
    <p>Versione speciale.</p>
    <span class="badge">Nuovo</span>
  </article>
  <article class="card">
    <div class="card-logo"><img src="Logo.jpg"></div>
    <h4><img src="Logo.jpg"> Aurora Midnight</h4>
    <p>Eleganza notturna.</p>
    <span class="badge">New</span>
  </article>
  <article class="card">
    <div class="card-logo"><img src="Logo.jpg"></div>
    <h4><img src="Logo.jpg"> Imperium Classic</h4>
    <p>Stile senza tempo.</p>
    <span class="badge">Best</span>
  </article>
</section>

<h2 class="section-title" id="assistenza"><img src="Logo.jpg"> Assistenza</h2>
<section class="assistenza">
  <div>
  </div>
  <div class="assistenza-box">
    <div class="assistenza-box-logo"><img src="Logo.jpg"></div>
    <h4><img src="Logo.jpg"></h4>
    <input type="text" placeholder="Nome">
    <input type="email" placeholder="Email">
    <textarea placeholder="Messaggio"></textarea>
    <button class="btn primary" style="width:100%;">Invia</button>
  </div>
</section>

</main>

<footer>
  <img src="Logo.jpg">
  <div>LUXEVIS – Lo sguardo che osa</div>
  <div>© 2026 LUXEVIS</div>
</footer>

<script>
let cartCount=0, cartTotal=0, price=980;
function formatEuro(v){return "€ "+v.toFixed(2).replace(".",",");}
function updateCart(){
  document.getElementById("cart-count").textContent=cartCount;
  document.getElementById("cart-total").textContent=formatEuro(cartTotal);
  const box=document.getElementById("cart-items");
  if(cartCount===0){box.innerHTML="Il tuo carrello è vuoto.";}
  else{
    box.innerHTML=`
      <div class="cart-item">
        <img src="Occhiale.jpg">
        <div>
          <div style="color:var(--oro);">Occhiali CARPE DIEM</div>
          <div>Quantità: ${cartCount}</div>
          <div>Prezzo: ${formatEuro(price)}</div>
          <button class="btn" style="font-size:11px;margin-top:6px;" onclick="clearCart()">Rimuovi</button>
        </div>
      </div>`;
  }
}
function addToCart(){cartCount++;cartTotal=cartCount*price;updateCart();document.getElementById("cart-panel").classList.add("open");}
function clearCart(){cartCount=0;cartTotal=0;updateCart();}
function toggleCart(){document.getElementById("cart-panel").classList.toggle("open");}
function scrollToSection(id){window.scrollTo({top:document.getElementById(id).offsetTop-80,behavior:"smooth"});}
updateCart();
</script>

</body>
</html>
